WORLD_LABS_API_KEY=your_world_labs_key_here
FAL_KEY=your_fal_key_here

# Optional: SFX analysis shells out to ffmpeg/ffprobe. Leave these unset if they are
# already on PATH. Windows installs usually are not. Point at the real executable,
# not a .cmd wrapper, because Node cannot execFile a .cmd.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
